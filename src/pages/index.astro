---
import BaseLayout from "@layouts/BaseLayout.astro";
import Prose from "@components/Prose.astro";
import Works from "@components/Works.astro";
import Now from "@components/Now.astro";
import Connect from "@components/Connect.astro";

import "@styles/global.css";

const pageTitle = "Samuel Duval";
// No need to specify metaDescription - BaseLayout will use the default
---

<script>
    import "../vendors/makegradient.js";
</script>

<BaseLayout pageTitle={pageTitle}>
    <div
        class="gradient"
        data-lumina-gradient
        data-colors='["#A6A6A6","#434343","#000000","#2E2E2E","#000000"]'
        data-mode="impasto"
        data-noise="0.33"
        data-speed="13"
    >
    </div>

    <div class="fade-up-container">
        <Prose />
        <Works />
        <Now />
        <Connect />
    </div>
</BaseLayout>

<style>
    .gradient {
        position: fixed;
        inset: 0;
        z-index: 0;
        opacity: 0;
        pointer-events: none;
        animation: gradientFadeIn 1500ms ease-out forwards;
    }

    .fade-up-container {
        position: relative;
        z-index: 1;
    }

    .fade-up-container :global(section) {
        opacity: 0;
        transform: translateY(30px);
        animation: fadeUp 0.8s ease-out forwards;
    }

    .fade-up-container :global(section:nth-child(1)) {
        animation-delay: 0s;
    }

    .fade-up-container :global(section:nth-child(2)) {
        animation-delay: 0.2s;
    }

    .fade-up-container :global(section:nth-child(3)) {
        animation-delay: 0.4s;
    }

    .fade-up-container :global(section:nth-child(4)) {
        animation-delay: 0.6s;
    }

    @keyframes fadeUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes gradientFadeIn {
        to {
            opacity: 10%;
        }
    }

    /* Reduce motion fallback */
    @media (prefers-reduced-motion: reduce) {
        .gradient {
            opacity: 7%;
            animation: none;
        }

        .fade-up-container :global(section) {
            opacity: 1;
            transform: none;
            animation: none;
        }
    }
</style>
